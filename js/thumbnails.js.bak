// js/thumbnails.js - Apartment thumbnail images for listing page
// Maps apartment IDs to their thumbnail image paths

const apartmentThumbnails = {
  1: 'assets/apartments/apartment1.jpeg',
  2: 'assets/apartments/apartment2.jpeg',
  3: 'assets/apartments/apartment3.jpeg',
  4: 'assets/apartments/apartment1.jpeg',
  5: 'assets/apartments/apartment2.jpeg',
  6: 'assets/apartments/apartment3.jpeg',
  7: 'assets/apartments/apartment1.jpeg',
  8: 'assets/apartments/apartment2.jpeg',
  9: 'assets/apartments/apartment3.jpeg',
  10: 'assets/apartments/apartment1.jpeg',
};

// Get thumbnail image for an apartment ID
function getThumbnailImage(apartmentId) {
  return apartmentThumbnails[apartmentId] || 'assets/apartments/apartment1.jpeg';
}
